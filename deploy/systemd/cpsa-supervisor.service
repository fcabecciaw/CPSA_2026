[Unit]
Description=CPSA medical demo supervisor (web dashboard + mode supervisor)
Documentation=file:///home/kria/cpsa/deploy/README.md
# The DPU application must be loaded before the supervisor starts.
Requires=cpsa-dpu.service
# No network-online.target: the server binds 0.0.0.0 and does not need a link,
# and waiting for it can delay the start by the wait-online timeout when the
# booth laptop is unplugged at boot. bluetooth.service is only ordered, not
# required: the BLE stack is used when it is there, and the medical mode reports
# imu_not_found when it is not.
After=cpsa-dpu.service bluetooth.service
Wants=bluetooth.service
# Restart forever: a crash or a `kill -9` always brings the supervisor back
# (NFR-05, AC-10). 0 disables the systemd start rate limit.
StartLimitIntervalSec=0

[Service]
Type=simple
User=kria
WorkingDirectory=/home/kria/cpsa
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/kria/cpsa/.venv/bin/cpsa-supervisor --config /home/kria/cpsa/config/board.demo.yaml
Restart=always
RestartSec=3
TimeoutStopSec=20

# Hardening that still needs a board test is kept commented out: the three
# directives below were reviewed against the code, but they have never been
# exercised on the KV260. PrivateTmp gives the unit a private /tmp, and the DPU
# runtime (XRT/VART), the UVC camera and bluepy-helper may rely on files there,
# so a break would show up only on the board. Enable them after a board test
# (systemctl restart, then a full IMU + camera + DPU run) and check
# `journalctl -u cpsa-supervisor -b` if anything fails.
#
#  - ProtectSystem=full: /usr, /boot and /etc read-only.
#  - PrivateTmp=yes: a private /tmp and /var/tmp for the unit.
#  - ProtectKernelModules=yes: blocks loading or unloading kernel modules.
#
# NoNewPrivileges=yes is deliberately absent from this list as well: it would
# drop the file capabilities granted to bluepy-helper (see below).
#
# enable after a board test:
# ProtectSystem=full
# PrivateTmp=yes
# ProtectKernelModules=yes

# The bluepy helper needs raw-socket capabilities. Do not run this unit as
# root; grant the capabilities to the helper in the project venv instead.
# deploy/deploy.sh does this idempotently after `uv sync`; the manual command is
#
#   sudo setcap "cap_net_raw+eip cap_net_admin+eip" \
#     /home/kria/cpsa/.venv/lib/python3.10/site-packages/bluepy/bluepy-helper
#
# and kria must be in the bluetooth group. Re-run setcap after a `uv sync` that
# replaces bluepy. See deploy/README.md for the full prerequisites.

[Install]
WantedBy=multi-user.target
