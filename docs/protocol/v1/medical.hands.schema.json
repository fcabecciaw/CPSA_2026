{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "medical.hands.schema.json",
  "title": "medical.hands data (server to client)",
  "type": "object",
  "properties": {
    "layout": {
      "type": "string"
    },
    "w": {
      "type": "integer"
    },
    "h": {
      "type": "integer"
    },
    "keypoints": {
      "type": "array",
      "items": {
        "type": "array",
        "prefixItems": [
          {
            "type": "number"
          },
          {
            "type": "number"
          },
          {
            "type": "number"
          }
        ],
        "minItems": 3,
        "maxItems": 3
      }
    },
    "subject_box": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 4,
          "maxItems": 4
        }
      ]
    }
  },
  "required": [
    "layout",
    "w",
    "h",
    "keypoints",
    "subject_box"
  ],
  "additionalProperties": true
}