{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "hologram.hands.schema.json",
  "title": "hologram.hands data (server to client)",
  "type": "object",
  "properties": {
    "seq": {
      "type": "integer",
      "minimum": 0
    },
    "t": {
      "type": "number"
    },
    "width": {
      "type": "integer"
    },
    "height": {
      "type": "integer"
    },
    "hands": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "score": {
            "type": "number"
          },
          "box": {
            "type": "array",
            "items": {
              "type": "number"
            },
            "minItems": 4,
            "maxItems": 4
          },
          "kpts2d": {
            "type": "array",
            "items": {
              "type": "array",
              "prefixItems": [
                {
                  "type": "number"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "minItems": 3,
              "maxItems": 3
            },
            "minItems": 21,
            "maxItems": 21
          },
          "kpts3d": {
            "type": "array",
            "items": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "number"
                  },
                  "minItems": 3,
                  "maxItems": 3
                }
              ]
            },
            "minItems": 21,
            "maxItems": 21
          }
        },
        "required": [
          "score",
          "box",
          "kpts2d",
          "kpts3d"
        ],
        "additionalProperties": true
      }
    },
    "timing": {
      "type": "object",
      "properties": {
        "dpu_ms": {
          "type": "number"
        },
        "total_ms": {
          "type": "number"
        }
      },
      "required": [
        "dpu_ms",
        "total_ms"
      ],
      "additionalProperties": true
    }
  },
  "required": [
    "seq",
    "t",
    "width",
    "height",
    "hands",
    "timing"
  ],
  "additionalProperties": true
}
