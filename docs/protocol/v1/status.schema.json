{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "status.schema.json",
  "title": "status data (server to client), 1 Hz and on change",
  "type": "object",
  "properties": {
    "state": {
      "enum": [
        "starting",
        "running",
        "error"
      ]
    },
    "camera": {
      "enum": [
        "ok",
        "missing",
        "error"
      ]
    },
    "model": {
      "type": "string",
      "description": "Stem of the loaded .xmodel."
    },
    "active_model": {
      "enum": [
        "yolox",
        "movenet"
      ],
      "description": "The view the dashboard shows (R2-G): both models keep running, model.set only switches the overlay and the pane."
    },
    "fps": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Processed frames per second, or null."
    },
    "dpu_ms": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "description": "Last inference time, or null."
    },
    "errors": {
      "type": "array",
      "items": {
        "enum": [
          "model_missing",
          "dpu_error",
          "camera_missing",
          "camera_error",
          "internal"
        ]
      },
      "description": "Codes of the conditions the process reports."
    },
    "uptime_s": {
      "type": "number",
      "minimum": 0
    }
  },
  "required": [
    "state",
    "camera",
    "model",
    "active_model",
    "fps",
    "dpu_ms",
    "errors",
    "uptime_s"
  ],
  "additionalProperties": true
}
