{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "rps.state.schema.json",
  "title": "rps.state data (server to client)",
  "type": "object",
  "properties": {
    "phase": {
      "enum": [
        "waiting",
        "ready",
        "countdown",
        "shoot",
        "result"
      ]
    },
    "count": {
      "enum": [
        3,
        2,
        1,
        null
      ]
    },
    "player": {
      "enum": [
        "rock",
        "paper",
        "scissors",
        "none",
        null
      ]
    },
    "player_p": {
      "type": [
        "number",
        "null"
      ],
      "minimum": 0,
      "maximum": 1
    },
    "board": {
      "enum": [
        "rock",
        "paper",
        "scissors",
        null
      ]
    },
    "outcome": {
      "enum": [
        "win",
        "lose",
        "draw",
        "unclear",
        null
      ]
    },
    "score": {
      "type": "object",
      "properties": {
        "player": {
          "type": "integer",
          "minimum": 0
        },
        "board": {
          "type": "integer",
          "minimum": 0
        },
        "draws": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "player",
        "board",
        "draws"
      ],
      "additionalProperties": true
    },
    "hand": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "kpts2d": {
              "type": "array",
              "items": {
                "type": "array",
                "prefixItems": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  },
                  {
                    "type": "number"
                  }
                ],
                "minItems": 3,
                "maxItems": 3
              },
              "minItems": 21,
              "maxItems": 21
            }
          },
          "required": [
            "kpts2d"
          ],
          "additionalProperties": true
        }
      ]
    }
  },
  "required": [
    "phase",
    "count",
    "player",
    "player_p",
    "board",
    "outcome",
    "score",
    "hand"
  ],
  "additionalProperties": true
}
