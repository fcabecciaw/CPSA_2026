{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "medical.episode.schema.json",
  "title": "medical.episode data (server to client)",
  "type": "object",
  "properties": {
    "episode_id": {
      "type": "string"
    },
    "active": {
      "type": "boolean"
    },
    "contact_count": {
      "type": "integer",
      "minimum": 0
    },
    "repetition_hz": {
      "type": [
        "number",
        "null"
      ]
    },
    "peak_severity": {
      "enum": [
        "NO_CLASS",
        "NON_DANGEROUS",
        "DANGEROUS",
        "NON_STEREOTIPY",
        null
      ]
    },
    "labels": {
      "type": "array",
      "items": {
        "enum": [
          "hand_to_face",
          "rocking",
          "hand_flapping"
        ]
      }
    },
    "contacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "side": {
            "enum": [
              "left",
              "right"
            ]
          },
          "region": {
            "enum": [
              "eyes",
              "mouth",
              "nose_cheek",
              "forehead_temple",
              "ear",
              "head_top"
            ]
          },
          "t_start": {
            "type": "number"
          },
          "duration_s": {
            "type": "number"
          },
          "hand_shape": {
            "enum": [
              "fist",
              "point_pinch",
              "open_palm",
              "unknown"
            ]
          }
        },
        "required": [
          "side",
          "region",
          "t_start",
          "duration_s",
          "hand_shape"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "episode_id",
    "active",
    "contact_count",
    "repetition_hz",
    "peak_severity",
    "labels",
    "contacts"
  ],
  "additionalProperties": true
}